# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=production
SECRET_KEY=change-me-to-a-long-random-string
JWT_SERVER_SECRET=change-me-another-long-random-string

POSTGRES_USER=yourlawyer
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=yourlawyer

OPENAI_API_KEY=sk-...
# Optional alias (same value):
# YOURLAWYER_OPENAI_API_KEY=sk-...

# PII anonymization before external LLM calls
PII_ANONYMIZATION_ENABLED=true
PII_NER_ENABLED=false

OTP_SECRET=change-me
OTP_API_KEY=
OTP_TEMPLATE_ID=0
OTP_URL=https://api.sms.ir/v1/send/verify

# Public site origins (comma-separated, no spaces preferred)
ALLOWED_ORIGINS=https://yourlawyeer.ir,https://www.yourlawyeer.ir

# Chroma vector DB (persisted legal chunks used by RAG)
# Docker: mounted at /app/storage/chroma — keep this in sync with the volume
CHROMA_DB_DIR=/app/storage/chroma
# Active collection after clean rebuild (old legal-texts kept for rollback)
CHROMA_COLLECTION=legal-texts-v2
# Refuse LLM answers when retrieval returns no usable chunks (grounding)
RAG_REQUIRE_RETRIEVED_CONTEXT=true

# Hierarchical taxonomy classify → Chroma metadata filter
# Keep false in production until backfill + eval comparison is approved
ENABLE_DOMAIN_FILTERED_RETRIEVAL=false
# Subdomain filter needs denser tags; leave false (domain-only when domain filter on)
ENABLE_SUBDOMAIN_FILTERED_RETRIEVAL=false
TAXONOMY_CLASSIFY_MIN_CONFIDENCE=0.6
TAXONOMY_LLM_CLASSIFY=true
# Expensive: LLM tag every ingest doc (default heuristic only)
USE_LLM_TAXONOMY_TAGGING=false

# Drop low-relevance chunks before generate (hybrid CrossEncoder + keyword)
# Recalibrated after audit: English MiniLM saturated ≈1.0; hybrid + 0.40 is usable.
# Prefer RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1 (multilingual)
MIN_SOURCE_RELEVANCE_SCORE=0.15
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_COLLAPSE_SPREAD=0.05

# Security
IP_WHITELIST_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
DOCS_ENABLED=false
# Mobiles that receive permission admin.manage (is_admin) on login — comma-separated
ADMIN_MOBILES=09120000000

# Redis (internal Docker service — do not expose ports)
# When QUOTA_ENABLED=true, Redis defaults on if REDIS_ENABLED is omitted
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# Monthly USD usage quotas (OpenAI cost control)
QUOTA_ENABLED=true
QUOTA_FAIL_CLOSED=true
FREE_MONTHLY_QUESTION_CAP=5
FREE_USER_MONTHLY_COST_CAP=0.08
SYSTEM_FREE_MONTHLY_CAP=18.0
PAID_SILVER_MONTHLY_COST_CAP=1.5
PAID_GOLD_MONTHLY_COST_CAP=4.0
SYSTEM_FREE_WARN_RATIO=0.8
QUOTA_DEFAULT_GLOBAL_USD=18
QUOTA_DEFAULT_USER_USD=0.08
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_MAX_COMPLETION_TOKENS=1024

# Per-query RAG instrumentation (JSONL; anonymized query only)
QUERY_TRACE_ENABLED=true
QUERY_TRACE_PATH=/app/storage/query_traces.jsonl

# Level-3 general guidance when classify is confident but retrieval is weak.
# Default false — enable only after manual review of sample outputs (no article claims).
ENABLE_GENERAL_GUIDANCE_FALLBACK=false
GENERAL_GUIDANCE_MIN_CLASSIFY_CONFIDENCE=0.6

# Pre-RAG intent detection (skip Chroma for meta/greeting/out_of_scope)
ENABLE_INTENT_DETECTION=true
INTENT_CACHE_TTL_SECONDS=3600

# Eval harness (local/staging only — never point at production by accident)
# EVAL_VIA=api
# EVAL_BASE_URL=http://127.0.0.1:8000
# EVAL_TOKEN=
# EVAL_USER_ID=
# EVAL_SLEEP_SECONDS=0.5
