# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=production
SECRET_KEY=change-me-to-a-long-random-string
JWT_SERVER_SECRET=change-me-another-long-random-string

POSTGRES_USER=yourlawyer
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=yourlawyer

OPENAI_API_KEY=sk-...
# Optional alias (same value):
# YOURLAWYER_OPENAI_API_KEY=sk-...

OTP_SECRET=change-me
OTP_API_KEY=
OTP_TEMPLATE_ID=0
OTP_URL=https://api.sms.ir/v1/send/verify

# Public site origins (comma-separated, no spaces preferred)
ALLOWED_ORIGINS=https://yourlawyeer.ir,https://www.yourlawyeer.ir

# Frontend
NEW_NEXT_PUBLIC_API_URL=https://yourlawyeer.ir/backend
NODE_ENV=production

# Security
IP_WHITELIST_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
DOCS_ENABLED=false
# Required for PUT /plans/update (send as header X-Plan-Admin-Secret)
PLAN_ADMIN_SECRET=change-me-plan-admin-secret
