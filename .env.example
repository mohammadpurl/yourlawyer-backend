# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=production
SECRET_KEY=change-me-to-a-long-random-string
JWT_SERVER_SECRET=change-me-another-long-random-string

POSTGRES_USER=yourlawyer
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=yourlawyer

OPENAI_API_KEY=sk-...
# Optional alias (same value):
# YOURLAWYER_OPENAI_API_KEY=sk-...

# PII anonymization before external LLM calls
PII_ANONYMIZATION_ENABLED=true
PII_NER_ENABLED=false

OTP_SECRET=change-me
OTP_API_KEY=
OTP_TEMPLATE_ID=0
OTP_URL=https://api.sms.ir/v1/send/verify

# Public site origins (comma-separated, no spaces preferred)
ALLOWED_ORIGINS=https://yourlawyeer.ir,https://www.yourlawyeer.ir

# Frontend
NEW_NEXT_PUBLIC_API_URL=https://yourlawyeer.ir/backend
NODE_ENV=production
# true when site is served over HTTPS
COOKIE_SECURE=true

# Security
IP_WHITELIST_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
DOCS_ENABLED=false
# Mobiles that receive permission admin.manage (is_admin) on login — comma-separated
ADMIN_MOBILES=09120000000

# Redis (internal Docker service — do not expose ports)
# When QUOTA_ENABLED=true, Redis defaults on if REDIS_ENABLED is omitted
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# Monthly USD usage quotas (OpenAI cost control)
QUOTA_ENABLED=true
QUOTA_FAIL_CLOSED=true
FREE_MONTHLY_QUESTION_CAP=5
FREE_USER_MONTHLY_COST_CAP=0.08
SYSTEM_FREE_MONTHLY_CAP=18.0
PAID_SILVER_MONTHLY_COST_CAP=1.5
PAID_GOLD_MONTHLY_COST_CAP=4.0
SYSTEM_FREE_WARN_RATIO=0.8
QUOTA_DEFAULT_GLOBAL_USD=18
QUOTA_DEFAULT_USER_USD=0.08
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_MAX_COMPLETION_TOKENS=1024
